import requests
from bs4 import BeautifulSoup

url = 'http://wiki.python.org.br/AprendaMais'
requisicao = requests.get(url)
extracao = BeautifulSoup(requisicao.text,'html.parser')

#para exibir o texto
print(extracao.text.strip())

#Filtrar a exibição pela tag
for linha_texto in extracao.find_all('h2'):
    titulo = linha_texto.text.strip()
    print('Titulo: ', titulo)

# Contar títulos e parágrafos
# Crias variáveis

contar_tiulos = 0
contar_paragrafos = 0

for linha_texto in extracao.find_all(['h2' , 'p']):
    if linha_texto.name == 'h2':
        contar_tiulos += 1
    elif linha_texto.name == 'p':
        contar_paragrafos += 1
print('Total de Títulos: ', contar_tiulos)
print('Total de Parágrafos: ', contar_paragrafos)

#Para exibir os textos de h2 e p

for linha_texto in extracao.find_all(['h2', 'p']):
    if linha_texto.name == 'h2':
        titulo = linha_texto.text.strip()
        print('Título: \n', titulo)
    elif linha_texto.name == 'p':
        paragrafo = linha_texto.text.strip()
        print('Parágrafo: \n', paragrafo)

#Exibir tags aninhada
for titulo in extracao.find_all('h2'):
    print('\n Título: ', titulo.text.strip())
    for link in titulo.find_next_sibling('p'):
        for a in link.find_all('a', href=True):
            print('Texto Link: ', a.text.strip(), ' | URL:', a["href"])
